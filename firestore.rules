rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid} {
      allow read: if request.auth.uid == uid;
      allow create: if request.auth.uid == uid
        && !('entitlement' in request.resource.data);
      allow update: if request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['entitlement']);
      // Settings -> Delete my account removes the whole document. The server's
      // DELETE /v1/account will take over once it exists (PRD 6.14).
      allow delete: if request.auth.uid == uid;

      match /journal/{id} {
        allow read, delete: if request.auth.uid == uid;
        allow create, update: if request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['savedAt'])
          && request.resource.data.savedAt is timestamp;
      }
      match /partners/{id} {
        allow read, delete: if request.auth.uid == uid;
        allow create, update: if request.auth.uid == uid
          && request.resource.data.keys().hasAll(['nickname', 'birthDate', 'createdAt'])
          && request.resource.data.keys().hasOnly(
            ['nickname', 'birthDate', 'birthTime', 'timeKnown', 'place', 'createdAt'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 1
          && request.resource.data.nickname.size() <= 30
          && request.resource.data.birthDate is string
          && request.resource.data.createdAt is timestamp
          && (!('birthTime' in request.resource.data)
              || request.resource.data.birthTime == null
              || request.resource.data.birthTime is string)
          && (!('timeKnown' in request.resource.data)
              || request.resource.data.timeKnown is bool)
          && (!('place' in request.resource.data)
              || request.resource.data.place == null
              || request.resource.data.place is map);
      }
      match /reports/{id}  { allow read: if request.auth.uid == uid; allow write: if false; }
    }
  }
}
